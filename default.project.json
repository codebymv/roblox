{
  "name": "CargoCatastrophe",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/Shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/Server"
      }
    },
    "ServerStorage": {
      "$className": "ServerStorage",
      "Tests": {
        "$className": "Folder",
        "StudioSmoke": {
          "$path": "Tests/StudioSmoke.luau"
        }
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": {
          "$path": "src/Client"
        }
      }
    },
    "Players": {
      "$className": "Players",
      "$properties": {
        "MaxPlayers": 16,
        "RespawnTime": 3
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "FilteringEnabled": true
      }
    }
  }
}
